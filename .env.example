# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# From your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-secret-key   # service_role key — keep this secret!

# A long random string used to sign Flask session cookies
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Currency symbol shown in the UI and Excel exports (default: ₹)
CURRENCY_SYMBOL=₹
